# ── Required ──────────────────────────────────────────────────────────────────
# Base URL of your Jellyfin server (no trailing slash)
JELLYFIN_URL=http://localhost:8096

# Jellyfin API key (Dashboard → API Keys → +)
JELLYFIN_API_KEY=your_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# User/group IDs for file ownership of the SQLite database (default: 1000)
PUID=1000
PGID=1000

# How often to sync automatically (Go duration: 30m, 1h, 6h, 24h…)
SYNC_INTERVAL=1h

# Minimum cooldown between syncs (Go duration: 30s, 5m, 10m… default: 10m)
MIN_SYNC_INTERVAL=10m

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Webhook notifications (optional)
# WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook
# WEBHOOK_TYPE=discord   # discord | slack | generic
